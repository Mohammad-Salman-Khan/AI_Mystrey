NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ai_mystery_room
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
CLIENT_ORIGIN=http://localhost:5173
CASE_TTL_DAYS=7
GEMINI_TIMEOUT_MS=120000
# Comma-separated DNS resolver IPs used for Node SRV/TXT lookups (mongodb+srv://).
DNS_SERVERS=8.8.8.8
